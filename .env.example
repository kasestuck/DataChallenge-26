# Copy to .env and set the key locally. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Stage 1 works without MODEL_API_KEY.
DATABASE_PATH=data/cqa.db
DATASET_API_URL=
DATASET_GROUP_ID=DEV

# Stage 2: completion includes hidden reasoning tokens.
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
LLM_USE_SYSTEM_TRUST=true
LLM_MAX_INPUT_CHARS=100000
# Per 1,000,000 tokens, in the currency of your provider's price list.
# Empty means unknown price; no invented zero cost.
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=

# API development origins (comma-separated) and model concurrency.
CORS_ORIGINS=*
MAX_CONCURRENCY=4
